rules_version='2';service firebase.storage{match /b/{bucket}/o{function admin(){return request.auth!=null&&firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))&&firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['owner','staff','Owner','Staff'];}match /atlasMedia/{fileName}{allow read:if true;allow write:if admin()&&request.resource.size<12*1024*1024&&request.resource.contentType.matches('image/.*');}match /{allPaths=**}{allow read,write:if false;}}}