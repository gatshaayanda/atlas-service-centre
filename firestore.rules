rules_version='2';service cloud.firestore{match /databases/{database}/documents{function signedIn(){return request.auth!=null;}function owner(uid){return signedIn()&&request.auth.uid==uid;}function admin(){return signedIn()&&exists(/databases/$(database)/documents/admins/$(request.auth.uid))&&get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner','staff','Owner','Staff'];}function validRequest(){return request.resource.data.keys().hasOnly(['customerId','createdAt','customerName','phone','service','vehicle','registration','preferred','location','notes','status','source'])&&request.resource.data.keys().hasAll(['createdAt','customerName','phone','service','vehicle','registration','preferred','location','notes','status','source'])&&request.resource.data.createdAt is string&&request.resource.data.customerName is string&&request.resource.data.phone is string&&request.resource.data.service is string&&request.resource.data.vehicle is string&&request.resource.data.registration is string&&request.resource.data.preferred is string&&request.resource.data.location is string&&request.resource.data.notes is string&&request.resource.data.status=='Submitted'&&request.resource.data.source in ['online','offline']&&(!request.resource.data.keys().hasAny(['customerId'])||request.resource.data.customerId is string);}function validCustomer(uid){return request.resource.data.keys().hasOnly(['uid','name','email','phone','location','notes','createdAt','updatedAt'])&&request.resource.data.uid==uid&&request.resource.data.name is string&&request.resource.data.email is string&&request.resource.data.phone is string&&request.resource.data.location is string&&request.resource.data.notes is string&&request.resource.data.createdAt is string&&request.resource.data.updatedAt is string;}match /admins/{uid}{allow read:if owner(uid);allow create,update,delete:if false;}match /customers/{uid}{allow read:if owner(uid);allow create,update:if owner(uid)&&validCustomer(uid);allow delete:if false;}match /serviceRequests/{id}{allow create:if validRequest()&&(!request.resource.data.keys().hasAny(['customerId'])||owner(request.resource.data.customerId));allow read:if admin()||(resource.data.keys().hasAny(['customerId'])&&owner(resource.data.customerId));allow update:if admin();allow delete:if admin();}match /{document=**}{allow read,write:if false;}}}